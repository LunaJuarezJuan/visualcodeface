@{
    ViewBag.Title = "Index";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>

    <!-- Bootstrap CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome para íconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Hoja de estilos personalizada -->
    <link href="~/Source/IndexStyles.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex flex-column min-vh-100 justify-content-center align-items-center">

    <div class="container text-center">
        <h1 class="mb-4">Bienvenido a Vectores Numéricos Luna-Chino</h1>

        <p class="lead">Sistema Inteligente de Asistencia Digital mediante Reconocimiento Facial</p>

        <p class="description">
            Este sistema permite registrar la asistencia de estudiantes y personal académico utilizando tecnología de reconocimiento facial,
            mejorando la precisión y reduciendo el tiempo necesario para los procesos administrativos.
        </p>

        <p class="description">
            Nuestro enfoque se basa en la seguridad biométrica y automatización educativa para garantizar eficiencia,
            fiabilidad y experiencia tecnológica moderna.
        </p>

        <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-lg mt-4">
            <i class="fas fa-sign-in-alt me-2"></i> Iniciar Sesión
        </a>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
