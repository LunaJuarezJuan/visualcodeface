@model List<VectoresNumericos_Luna_Chino.Controllers.DocenteController.SesionConClase>

@{
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
    ViewBag.Title = "Sesiones Activas";
}

@section Styles {
    <link href="~/Source/ClasesDocenteStyles.css" rel="stylesheet" />
}

<div class="clases-container">
    <h2 class="titulo-pagina"><i class="fas fa-calendar-alt me-2"></i>@ViewBag.Title</h2>

    <form method="get" class="form-inline mb-3">
        <div class="form-group me-3">
            <label for="estadoFiltro" class="me-2">Estado:</label>
            <select name="estadoFiltro" id="estadoFiltro" class="form-control">
                <option value="todos">Todos</option>
                @foreach (var estado in ViewBag.ListaEstados as List<string>)
                {
                    <option value="@estado" @(ViewBag.EstadoFiltro == estado ? "selected" : "")>@estado</option>
                }
            </select>
        </div>

        <div class="form-group me-3">
            <label for="claseFiltro" class="me-2">Clase:</label>
            <select name="claseFiltro" id="claseFiltro" class="form-control">
                <option value="todas">Todas</option>
                @foreach (var clase in ViewBag.ListaClases as List<string>)
                {
                    <option value="@clase" @(ViewBag.ClaseFiltro == clase ? "selected" : "")>@clase</option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Filtrar</button>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay sesiones activas en este momento.</div>
    }
    else
    {
        <table class="table table-striped tabla-clases">
            <thead>
                <tr>
                    <th>ID Sesión</th>
                    <th>Nombre Sesión</th>
                    <th>Clase</th>
                    <th>Hora Inicio</th>
                    <th>Hora Fin</th>
                    <th>Estado</th>
                    <th>Progreso</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sesion in Model)
                {
                    string countdownId = $"countdown_{sesion.IdSesion}";
                    string timerId = $"timer_{sesion.IdSesion}";
                    string inicioStr = sesion.FechaHoraInicio.ToString("yyyy-MM-ddTHH:mm:ss");
                    string finStr = sesion.FechaHoraFin.ToString("yyyy-MM-ddTHH:mm:ss");
                    bool expirada = sesion.FechaHoraFin < DateTime.Now;

                    <tr class="@(expirada ? "table-secondary" : "")">
                        <td>@sesion.IdSesion</td>
                        <td>@sesion.NombreSesion</td>
                        <td>@sesion.NombreClase</td>
                        <td>@sesion.FechaHoraInicio.ToString("g")</td>
                        <td>@sesion.FechaHoraFin.ToString("g")</td>
                        <td>@sesion.Estado</td>
                        <td>
                            <span id="@countdownId" class="text-primary small"></span>
                            <span id="@timerId" class="text-success small d-block mt-1"></span>
                        </td>
                        <td>
                            <a href="@Url.Action("IniciarReconocimiento", "Docente", new { idSesion = sesion.IdSesion })"
                               class="btn btn-primary btn-sm @(expirada ? "disabled" : "")">
                                Iniciar Reconocimiento
                            </a>
                        </td>
                    </tr>

                    <script>
                        (function () {
                            const idSesion = '@sesion.IdSesion';
                            const inicio = new Date('@inicioStr');
                            const fin = new Date('@finStr');
                            const countdownEl = document.getElementById('countdown_' + idSesion);
                            const timerEl = document.getElementById('timer_' + idSesion);

                            function update() {
                                const now = new Date();
                                if (now < inicio) {
                                    const diff = inicio - now;
                                    const mins = Math.floor(diff / 60000);
                                    const secs = Math.floor((diff % 60000) / 1000);
                                    countdownEl.innerText = `Empieza en ${mins}m ${secs}s`;
                                    timerEl.innerText = '';
                                } else if (now >= inicio && now <= fin) {
                                    const diff = now - inicio;
                                    const mins = Math.floor(diff / 60000);
                                    const secs = Math.floor((diff % 60000) / 1000);
                                    countdownEl.innerText = '';
                                    timerEl.innerText = `Transcurrido: ${mins}m ${secs}s`;
                                } else {
                                    countdownEl.innerText = 'Finalizada';
                                    timerEl.innerText = '';
                                }
                            }

                            update();
                            setInterval(update, 1000);
                        })();
                    </script>
                }
            </tbody>
        </table>
    }
</div>
