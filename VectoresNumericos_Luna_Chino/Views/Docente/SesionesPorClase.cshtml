@model List<VectoresNumericos_Luna_Chino.Controllers.DocenteController.SesionConClase>

@{
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
    ViewBag.Title = "Sesiones de " + ViewBag.NombreClase;
}

@section Styles {
    <link href="~/Source/ClasesDocenteStyles.css" rel="stylesheet" />
}

<div class="clases-container">
    <h2 class="titulo-pagina"><i class="fas fa-calendar-alt me-2"></i>@ViewBag.Title</h2>

    <table class="table table-striped tabla-clases">
        <thead>
            <tr>
                <th>Nombre Sesión</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sesion in Model)
            {
                <tr>
                    <td>@sesion.NombreSesion</td>
                    <td>@sesion.FechaHoraInicio.ToString("g")</td>
                    <td>@sesion.FechaHoraFin.ToString("g")</td>
                    <td>
                   
                        <a href="@Url.Action("IniciarReconocimiento", "Docente", new { idSesion = sesion.IdSesion })" class="btn btn-primary btn-sm">Iniciar</a>
                        <a href="@Url.Action("EditarSesion", "Docente", new { idSesion = sesion.IdSesion })" class="btn btn-primary btn-sm">Editar</a>
                        <a href="@Url.Action("DeshabilitarSesion", "Docente", new { idSesion = sesion.IdSesion })" class="btn btn-danger btn-sm" onclick="return confirm('¿Estás seguro de deshabilitar esta sesión?');">Deshabilitar</a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
