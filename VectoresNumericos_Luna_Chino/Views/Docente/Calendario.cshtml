@model List<VectoresNumericos_Luna_Chino.Models.SesionConClase>

@{
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
    ViewBag.Title = "Calendario de Sesiones";
}

<!-- FullCalendar CSS -->
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/main.min.css' rel='stylesheet' />
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- FullCalendar JS -->
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/main.min.js'></script>
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/locales/es.js'></script>
<!-- Tippy.js para tooltips -->
<script src="https://unpkg.com/tippy.js@6"></script>

<style>
    #calendar {
        margin: 20px auto;
        max-width: 1200px;
        height: 800px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .fc-event {
        border: none;
        padding: 3px 5px;
        margin: 1px 0;
        font-size: 12px;
    }

    .fc-event-activo {
        background-color: #4CAF50;
        border-left: 4px solid #2E7D32;
    }

    .fc-event-inactivo {
        background-color: #9E9E9E;
        border-left: 4px solid #616161;
    }

    .fc-event-finalizado {
        background-color: #2196F3;
        border-left: 4px solid #1565C0;
    }

    .fc-event-deshabilitado {
        background-color: #F44336;
        border-left: 4px solid #C62828;
    }

    .fc-day-today {
        background-color: #FFF8E1 !important;
    }
</style>


<!-- Sección de depuración -->
<div class="bg-light p-3 mt-3 rounded">
    <h4>Datos de Depuración (@Model.Count sesiones)</h4>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Sesión</th>
                <th>Clase</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sesion in Model)
            {
                <tr>
                    <td>@sesion.NombreSesion</td>
                    <td>@sesion.NombreClase</td>
                    <td>@sesion.FechaHoraInicio.ToString("g")</td>
                    <td>@sesion.FechaHoraFin.ToString("g")</td>
                    <td>@sesion.Estado</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var calendarEl = document.getElementById('calendar');

    // Convertir modelo a eventos para FullCalendar
    var eventos = [
        @foreach (var sesion in Model)
        {
            var inicio = sesion.FechaHoraInicio.ToString("yyyy-MM-ddTHH:mm:ss");
            var fin = sesion.FechaHoraFin.ToString("yyyy-MM-ddTHH:mm:ss");
            var titulo = $"{sesion.NombreSesion} - {sesion.NombreClase}";
            var descripcion = sesion.Descripcion ?? string.Empty;
            var estado = sesion.Estado.ToLower();

            <text>
            {
                id: '@sesion.IdSesion',
                title: '@Html.Raw(titulo.Replace("'", "\\'"))',
                start: '@inicio',
                end: '@fin',
                description: '@Html.Raw(descripcion.Replace("'", "\\'"))',
                extendedProps: {
                    estado: '@estado'
                },
                className: 'fc-event-@estado'
            },
            </text>
        }
    ];

    console.log("Eventos cargados:", eventos); // Para depuración

    var calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,timeGridWeek,timeGridDay'
        },
        locale: 'es',
        firstDay: 1, // Lunes como primer día
        navLinks: true,
        editable: false,
        dayMaxEvents: true,
        events: eventos,
        eventDidMount: function(info) {
            if (info.event.extendedProps.description) {
                tippy(info.el, {
                    content: info.event.extendedProps.description,
                    placement: 'top',
                    allowHTML: true
                });
            }
            info.el.style.cursor = 'pointer';
        },
        eventClick: function(info) {
            alert('Sesión: ' + info.event.title + '\n' +
                  'Inicio: ' + info.event.start.toLocaleString() + '\n' +
                  'Fin: ' + info.event.end.toLocaleString() + '\n' +
                  'Estado: ' + info.event.extendedProps.estado);
        }
    });

    calendar.render();
});
</script>