@model List<VectoresNumericos_Luna_Chino.Models.Clase>
@{
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
    ViewBag.Title = "Mis Clases";
}

<h2>@ViewBag.Title</h2>

<p>
    @Html.ActionLink("Crear Nueva Clase", "CrearClase", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var clase in Model)
        {
            <tr>
                <td>@clase.NombreClase</td>
                <td>@(clase.Descripcion ?? "Sin descripción")</td>
                <td>
                    @Html.ActionLink("Ver Alumnos", "VerAlumnos", new { idClase = clase.IdClase }, new { @class = "btn btn-info btn-xs" })
                    @Html.ActionLink("Agregar Alumnos", "AgregarAlumno", new { idClase = clase.IdClase }, new { @class = "btn btn-success btn-xs" })
                    @Html.ActionLink("Sesiones", "SesionesActivas", new { idClase = clase.IdClase }, new { @class = "btn btn-warning btn-xs" })
                </td>
            </tr>
        }
    </tbody>
</table>