@model List<VectoresNumericos_Luna_Chino.Models.AlumnoClase>

@{
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
    var nombreClase = ViewBag.NombreClase as string ?? "Clase sin nombre";
    var idClase = ViewBag.IdClase ?? 0; // fallback si es null
    ViewBag.Title = "Alumnos de " + nombreClase;
}

@section Styles {
    <link href="~/Source/VerAlumnosStyles.css" rel="stylesheet" />
}

<h2>@ViewBag.Title</h2>

<p class="acciones-superiores">
    @Html.ActionLink("Agregar Alumno", "AgregarAlumno", new { idClase = idClase }, new { @class = "btn btn-success" })
    @Html.ActionLink("Volver a Clases", "ClasesDocente", null, new { @class = "btn btn-secondary" })
</p>

@if (Model != null && Model.Any())
{
    <table class="table table-hover alumnos-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo Electrónico</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var alumno in Model)
            {
                <tr>
                    <td>@alumno.NombreAlumno</td>
                    <td>@alumno.CorreoAlumno</td>
                    <td>
                        @Html.ActionLink("Ver Asistencia", "ReporteAsistenciaAlumno", new { idAlumno = alumno.IdAlumno, idClase = idClase }, new { @class = "btn btn-info btn-sm me-1" })

                        @Html.ActionLink("Quitar", "QuitarAlumno", new { idAlumno = alumno.IdAlumno, idClase = idClase }, new
                        {
                            @class = "btn btn-info btn-sm me-1",
                            onclick = "return confirm('¿Estás seguro de que deseas quitar a este alumno de la clase?');"
                        })
                    </td>

                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">
        No se encontraron alumnos registrados en esta clase.
    </div>
}
