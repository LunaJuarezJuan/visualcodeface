@model List<VectoresNumericos_Luna_Chino.Models.SesionConClase>

@{
    ViewBag.Title = "Crear Sesión";
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
}

@section Styles {
    <link href="~/Source/CrearSesionStyles.css" rel="stylesheet" />
}

<div class="crear-sesion-container">
    <h2>Crear Sesión</h2>

    @using (Html.BeginForm("CrearSesion", "Docente", FormMethod.Post))
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger validation-summary" })

        <div class="form-group">
            <label for="idClase">Clase:</label>
            <select id="idClase" name="idClase" required class="form-control">
                <option value="">-- Seleccione una clase --</option>
                @foreach (var clase in ViewBag.Clases as List<VectoresNumericos_Luna_Chino.Models.Clase>)
                {
                    <option value="@clase.IdClase">@clase.NombreClase</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label for="fechaHoraInicio">Fecha y hora de inicio:</label>
            <input type="datetime-local" id="fechaHoraInicio" name="fechaHoraInicio" required class="form-control" />
        </div>

        <div class="form-group">
            <label for="fechaHoraFin">Fecha y hora de fin:</label>
            <input type="datetime-local" id="fechaHoraFin" name="fechaHoraFin" required class="form-control" />
        </div>

        <div class="form-group">
            <label for="nombreSesion">Nombre de la sesión</label>
            <input type="text" class="form-control" id="nombreSesion" name="nombreSesion" required />
        </div>

        <div class="form-group">
            <label for="descripcion">Descripción</label>
            <textarea class="form-control" id="descripcion" name="descripcion"></textarea>
        </div>

        <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input" id="sesionesRecurrentes" name="sesionesRecurrentes" />
            <label class="form-check-label" for="sesionesRecurrentes">Repetir cada lunes durante 6 meses</label>
        </div>

        <button type="submit" class="btn btn-primary">Crear Sesión</button>
    }

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Mensaje"]
        </div>
    }

    @if (ViewBag.SesionesSemana != null && ((List<VectoresNumericos_Luna_Chino.Models.SesionConClase>)ViewBag.SesionesSemana).Any())
    {
        <hr />
        <h3>Sesiones programadas para esta semana</h3>
        <table class="table table-bordered table-striped mt-3">
            <thead>
                <tr>
                    <th>Nombre de la Sesión</th>
                    <th>Clase</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sesion in ViewBag.SesionesSemana as List<VectoresNumericos_Luna_Chino.Models.SesionConClase>)
                {
                    <tr>
                        <td>@sesion.NombreSesion</td>
                        <td>@sesion.NombreClase</td>
                        <td>@sesion.FechaHoraInicio.ToString("g")</td>
                        <td>@sesion.FechaHoraFin.ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
