@model VectoresNumericos_Luna_Chino.Models.AlumnoViewModel
@{
    Layout = "~/Views/Shared/_LayoutAlumno.cshtml";
    ViewBag.Title = "Dashboard Alumno";
}

<h1>Bienvenido, @Model.NombreCompleto</h1>
<p>Correo: @Model.Correo</p>
<link href="~/Source/DatosAlumno.css" rel="stylesheet" />

<div class="card" style="max-width: 400px;">
    <div class="card-body text-center">
        <h5 class="card-title">Porcentaje de Asistencia</h5>

        <!-- selector de tipo de gráfico -->
        <label for="chartType">Tipo de gráfico:</label>
        <select id="chartType" class="form-select mb-3" style="max-width: 200px; margin: 0 auto;">
            <option value="doughnut" selected>Aro</option>
            <option value="bar">Barras</option>
            <option value="pie">Pastel</option>
        </select>

        <!-- gráfico -->
        <canvas id="attendanceChart"></canvas>

        <!-- texto debajo -->
        <p class="mt-3">
            <strong>@Model.PorcentajeAsistencia %</strong> de asistencia
        </p>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<script>
    const porcentaje = @Model.PorcentajeAsistencia;
    const faltas = 100 - porcentaje;

    const data = {
        labels: ['Asistencia', 'Faltas'],
        datasets: [{
            label: 'Asistencia',
            data: [porcentaje, faltas],
            backgroundColor: ['#4caf50', '#e0e0e0'],
            borderWidth: 0
        }]
    };

    const baseOptions = {
        responsive: true,
        plugins: {
            legend: { display: true },
            tooltip: { enabled: true },
        },
        animation: {
            animateRotate: true,
            duration: 1000
        },
        cutout: '70%' // Solo para doughnut
    };

    let chart; // Variable global para destruir y recrear

    function renderChart(type) {
        const ctx = document.getElementById('attendanceChart').getContext('2d');

        // Si ya existe, lo destruimos antes de crear el nuevo
        if (chart) {
            chart.destroy();
        }

        // Ajustamos opciones según tipo
        const options = JSON.parse(JSON.stringify(baseOptions)); // Copia profunda

        if (type !== 'doughnut') {
            delete options.cutout; // solo doughnut usa esto
        }

        chart = new Chart(ctx, {
            type,
            data,
            options
        });
    }

    // Render inicial
    document.addEventListener('DOMContentLoaded', () => {
        renderChart('doughnut');

        document.getElementById('chartType').addEventListener('change', function () {
            renderChart(this.value);
        });
    });
</script>
