@* Views/Shared/_LayoutDocente.cshtml *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Dashboard Docente</title>
    <link href="~/Source/HomeStyles.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    @RenderSection("Styles", required: false)  @* <---- ESTA LÍNEA ES CLAVE *@
</head>
<body>
    <div class="sidebar">
        <header>Mi Dashboard</header>
        <nav>
            <a href="@Url.Action("Index", "Docente")" class="active"><i class="fas fa-home"></i> Inicio</a>
            <a href="@Url.Action("ClasesDocente", "Docente")"><i class="fas fa-graduation-cap"></i> Mis clases</a>
            <a href="@Url.Action("Perfil", "Docente")"><i class="fas fa-user"></i> Perfil</a>
            <a href="@Url.Action("Asistencia", "Docente")"><i class="fas fa-check-circle"></i> Asistencia</a>
            <a href="@Url.Action("Calificaciones", "Docente")"><i class="fas fa-graduation-cap"></i> Calendario</a>
            <a href="@Url.Action("ReporteAsistencia", "Docente")"><i class="fas fa-graduation-cap"></i> Reporte Asistencia</a>
            <a href="@Url.Action("CrearSesion", "Docente")"><i class="fas fa-graduation-cap"></i> Crear Sesion</a>
            <a href="@Url.Action("SesionesActivas", "Docente")"><i class="fas fa-graduation-cap"></i> Sesiones Activas</a>
            <a href="@Url.Action("Logout", "Account")"><i class="fas fa-sign-out-alt"></i> Cerrar Sesion</a>
        </nav>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>
</body>
</html>
