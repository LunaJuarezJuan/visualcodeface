@model List<VectoresNumericos_Luna_Chino.Models.Clase>

@{
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
    ViewBag.Title = "Panel Docente";
}

<h2>Mis Clases</h2>

@if (!Model.Any())
{
    <p>No tienes clases asignadas.</p>
}
else
{
    <table border="1" cellpadding="5" cellspacing="0">
        <thead>
            <tr>
                <th>ID Clase</th>
                <th>Nombre de la Clase</th>
                <th>Descripción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var clase in Model)
            {
                <tr>
                    <td>@clase.IdClase</td>
                    <td>@clase.NombreClase</td>
                    <td>@clase.Descripcion</td>
                </tr>
            }
        </tbody>
    </table>
}
