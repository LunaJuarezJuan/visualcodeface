@{
    ViewBag.Title = "Crear Sesión";
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
    ViewBag.Title = "Panel Docente";
}


<h2>Crear Sesión</h2>

@using (Html.BeginForm("CrearSesion", "Docente", FormMethod.Post))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div>
        <label for="idClase">Clase:</label>
        <select id="idClase" name="idClase" required>
            <option value="">-- Seleccione una clase --</option>
            @foreach (var clase in ViewBag.Clases as List<VectoresNumericos_Luna_Chino.Models.Clase>)
            {
                <option value="@clase.IdClase">@clase.NombreClase</option>
            }
        </select>
    </div>

    <div>
        <label for="fechaHoraInicio">Fecha y hora de inicio:</label>
        <input type="datetime-local" id="fechaHoraInicio" name="fechaHoraInicio" required />
    </div>

    <div>
        <label for="fechaHoraFin">Fecha y hora de fin:</label>
        <input type="datetime-local" id="fechaHoraFin" name="fechaHoraFin" required />
    </div>

    <button type="submit">Crear Sesión</button>
}

@if (TempData["Mensaje"] != null)
{
    <p style="color:green">@TempData["Mensaje"]</p>
}