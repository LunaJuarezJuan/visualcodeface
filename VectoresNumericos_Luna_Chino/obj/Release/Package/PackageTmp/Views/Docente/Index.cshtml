@{
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
    ViewBag.Title = "Panel Docente";
}

@section Styles {
    <link href="~/Source/IndexDocenteStyles.css" rel="stylesheet" />
}

<h2>@ViewBag.Message</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert-success">
        @TempData["Mensaje"]
    </div>
}

<div class="docente-links">
    <a href="@Url.Action("CrearSesion", "Docente")">Crear nueva sesión</a> |
    <a href="@Url.Action("SesionesActivas", "Docente")">Ver sesiones activas</a> |
    <a href="@Url.Action("ClasesDocente", "Docente")">Mis clases</a>
</div>
